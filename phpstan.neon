includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Livewire single-file components in resources/views/pages use these traits.
        # PHPStan does not analyse Blade files, so it cannot see the usage.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/*
